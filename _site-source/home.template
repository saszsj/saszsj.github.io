{{metadata}}
  <meta name="theme-color" content="#0b1220" />
{{analyticsScript}}

  <script>
    if (location.hostname === 'saszsj.github.io') {
      const target = new URL(location.href);
      target.protocol = 'https:';
      target.hostname = 'www.zsj.fr';
      target.port = '';
      location.replace(target.href);
    }
  </script>
  <link rel="stylesheet" href="/assets/chat.css" />
  <script type="module" src="/assets/chat.js"></script>

  <!-- Tailwind CDN（快速上线版） -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    .glass { backdrop-filter: blur(10px); background: rgba(255,255,255,0.06); }
    .grid-bg {
      background-image: radial-gradient(rgba(255,255,255,0.10) 1px, transparent 0);
      background-size: 24px 24px;
      background-position: -12px -12px;
    }
    .shadow-soft { box-shadow: 0 10px 30px rgba(0,0,0,.25); }
    .btn { transition: transform .06s ease; }
    .btn:active { transform: translateY(1px); }
    .lang-btn { border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; padding: 6px 8px; font-size: 12px; color: rgba(255,255,255,0.85); }
    .lang-btn.active { background: #fff; color: #0b1220; border-color: #fff; }
  </style>
</head>

