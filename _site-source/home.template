<!doctype html>
<html lang="{{locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
{{metadata}}
  <meta name="theme-color" content="#111a1e" />
{{analyticsScript}}
  <script>
    if (location.hostname === 'saszsj.github.io') {
      const target = new URL(location.href);
      target.protocol = 'https:';
      target.hostname = 'www.zsj.fr';
      target.port = '';
      location.replace(target.href);
    }
  </script>
  <link rel="stylesheet" href="{{assetPrefix}}assets/site.css" />
  <link rel="stylesheet" href="{{assetPrefix}}assets/chat.css" />
  <script defer src="{{assetPrefix}}assets/chat.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top">ZSJ<span aria-hidden="true"></span></a>
      <nav class="site-nav">
        <a href="#scenarios">
          <span data-lang-inline="zh-CN">转型机会</span>
          <span data-lang-inline="fr">L’opportunité</span>
          <span data-lang-inline="en">The opportunity</span>
          <span data-lang-inline="it">L’opportunità</span>
        </a>
        <a href="#demo">
          <span data-lang-inline="zh-CN">转型示例</span>
          <span data-lang-inline="fr">Démonstration</span>
          <span data-lang-inline="en">Example</span>
          <span data-lang-inline="it">Esempio</span>
        </a>
        <a href="#services">
          <span data-lang-inline="zh-CN">30 天试点</span>
          <span data-lang-inline="fr">Pilote 30 jours</span>
          <span data-lang-inline="en">30-day pilot</span>
          <span data-lang-inline="it">Pilota di 30 giorni</span>
        </a>
      </nav>
      <div class="locale-switch">
{{languageLinks}}
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">
            <span data-lang-inline="zh-CN">面向海外华人企业</span>
            <span data-lang-inline="fr">Pour les entreprises de la diaspora chinoise</span>
            <span data-lang-inline="en">For overseas Chinese businesses</span>
            <span data-lang-inline="it">Per le imprese della diaspora cinese</span>
          </p>
          <h1>
            <span data-lang-inline="zh-CN">现在正是<br class="wide-break" />AI 转型的好时机。</span>
            <span data-lang-inline="fr">C’est le moment d’engager votre transformation avec l’IA.</span>
            <span data-lang-inline="en">Now is the time to start your AI transformation.</span>
            <span data-lang-inline="it">È il momento di avviare la vostra trasformazione con l’IA.</span>
          </h1>
          <p class="hero-intro">
            <span data-lang-inline="zh-CN">AI 正在改变企业经营和发展的方式。ZSJ 从你的经营目标出发，和你一起找到值得先做的事，让团队在实际业务中用起来。</span>
            <span data-lang-inline="fr">L’IA change la façon de travailler et de développer son entreprise. ZSJ part de vos objectifs, choisit avec vous une première priorité et aide votre équipe à la mettre en pratique.</span>
            <span data-lang-inline="en">AI is changing how businesses work and grow. ZSJ starts with your goals, helps you choose a first priority, and supports your team as they put it into practice.</span>
            <span data-lang-inline="it">L’IA sta cambiando il modo in cui le imprese lavorano e crescono. ZSJ parte dai vostri obiettivi, individua con voi una priorità e aiuta il team a metterla in pratica.</span>
          </p>
          <div class="actions">
            <a class="button button-primary" href="#contact">
              <span data-lang-inline="zh-CN">聊聊我的项目</span>
              <span data-lang-inline="fr">Parler de mon projet</span>
              <span data-lang-inline="en">Discuss my project</span>
              <span data-lang-inline="it">Parlare del mio progetto</span>
            </a>
            <a class="button button-quiet" href="#demo">
              <span data-lang-inline="zh-CN">查看转型示例</span>
              <span data-lang-inline="fr">Voir un exemple</span>
              <span data-lang-inline="en">See an example</span>
              <span data-lang-inline="it">Vedere un esempio</span>
            </a>
          </div>
        </div>
        <a class="pilot-preview" href="#services">
          <span class="preview-label">
            <span data-lang-inline="zh-CN">AI 转型试点</span>
            <span data-lang-inline="fr">Pilote de transformation IA</span>
            <span data-lang-inline="en">AI transformation pilot</span>
            <span data-lang-inline="it">Pilota di trasformazione IA</span>
          </span>
          <span class="preview-duration">30
            <span class="preview-unit">
              <span data-lang-inline="zh-CN">天</span>
              <span data-lang-inline="fr">jours</span>
              <span data-lang-inline="en">days</span>
              <span data-lang-inline="it">giorni</span>
            </span>
          </span>
          <span class="preview-caption">
            <span data-lang-inline="zh-CN">选定一个经营重点，和团队验证可行性，再决定如何推进。</span>
            <span data-lang-inline="fr">Une priorité métier, un essai avec votre équipe et un bilan pour décider de la suite.</span>
            <span data-lang-inline="en">One business priority, a test with your team, and a review to decide what comes next.</span>
            <span data-lang-inline="it">Una priorità aziendale, un test con il team e un bilancio per decidere come proseguire.</span>
          </span>
          <span class="preview-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="section opportunity" id="scenarios">
      <div class="wrap split">
        <h2>
          <span data-lang-inline="zh-CN">为什么现在值得行动？</span>
          <span data-lang-inline="fr">Pourquoi agir maintenant&nbsp;?</span>
          <span data-lang-inline="en">Why act now?</span>
          <span data-lang-inline="it">Perché agire ora?</span>
        </h2>
        <div class="section-copy">
          <p>
            <span data-lang-inline="zh-CN">AI 工具越来越容易上手。企业现在就可以从一个经营重点入手，用小范围试点判断哪些做法值得推广。</span>
            <span data-lang-inline="fr">Les outils d’IA sont plus accessibles. Vous pouvez commencer sur une priorité métier, observer ce qui fonctionne pour votre équipe et décider où investir ensuite.</span>
            <span data-lang-inline="en">AI tools are easier to get started with. You can test one business priority, see what works for your team, and decide where to invest next.</span>
            <span data-lang-inline="it">Gli strumenti di IA sono più accessibili. Potete partire da una priorità aziendale, osservare cosa funziona per il team e decidere dove investire in seguito.</span>
          </p>
          <p>
            <span data-lang-inline="zh-CN">海外华人企业熟悉不同语言、文化和市场。现在有机会把这些跨境经验变成团队共享的做法，为下一阶段的增长做准备。</span>
            <span data-lang-inline="fr">Travailler entre plusieurs langues, cultures et marchés vous donne déjà une expérience précieuse. L’IA offre l’occasion de mieux la partager au sein de votre équipe et de préparer votre prochaine étape de croissance.</span>
            <span data-lang-inline="en">Working across languages, cultures and markets gives you valuable experience. AI creates an opportunity to share that know-how across your team and prepare for your next stage of growth.</span>
            <span data-lang-inline="it">Lavorare tra lingue, culture e mercati diversi vi dà un’esperienza preziosa. L’IA offre l’opportunità di condividerla meglio nel team e di preparare la prossima fase di crescita.</span>
          </p>
        </div>
      </div>
    </section>

    <section class="section demo" id="demo">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">
            <span data-lang-inline="zh-CN">转型示例 · 模拟案例</span>
            <span data-lang-inline="fr">Démonstration · exemple fictif</span>
            <span data-lang-inline="en">Demonstration · fictional example</span>
            <span data-lang-inline="it">Dimostrazione · esempio fittizio</span>
          </p>
          <h2>
            <span data-lang-inline="zh-CN">从「想用 AI」到知道下一步怎么走</span>
            <span data-lang-inline="fr">De l’envie d’utiliser l’IA à un plan d’action</span>
            <span data-lang-inline="en">From interest in AI to a plan of action</span>
            <span data-lang-inline="it">Dall’interesse per l’IA a un piano d’azione</span>
          </h2>
          <p>
            <span data-lang-inline="zh-CN">一家面向多个市场经营的华人企业正在扩张。负责人希望借助 AI 支持增长，首先要弄清楚从哪里开始。</span>
            <span data-lang-inline="fr">Une entreprise de la diaspora chinoise se développe sur plusieurs marchés. Sa direction veut s’appuyer sur l’IA pour accompagner cette croissance et cherche par où commencer.</span>
            <span data-lang-inline="en">An overseas Chinese business is expanding across several markets. Its leadership wants to use AI to support growth and needs to decide where to begin.</span>
            <span data-lang-inline="it">Un’impresa della diaspora cinese si espande in più mercati. La direzione vuole usare l’IA per sostenere la crescita e deve capire da dove iniziare.</span>
          </p>
        </div>
        <ol class="demo-steps">
          <li>
            <h3>
              <span data-lang-inline="zh-CN">找到切入点</span>
              <span data-lang-inline="fr">Choisir une priorité</span>
              <span data-lang-inline="en">Choose a priority</span>
              <span data-lang-inline="it">Scegliere una priorità</span>
            </h3>
            <p>
              <span data-lang-inline="zh-CN">各地团队选定一个目标：让新市场的同事更快掌握成熟市场积累的经营经验。他们约定记录上手所需的时间和遇到的难点。</span>
              <span data-lang-inline="fr">Les équipes choisissent un objectif : aider les collègues d’un nouveau marché à s’approprier plus vite les pratiques du groupe. Elles suivent le temps d’adaptation et les difficultés rencontrées.</span>
              <span data-lang-inline="en">The teams choose one goal: help colleagues in a new market pick up proven practices faster. They track how long that takes and where people get stuck.</span>
              <span data-lang-inline="it">I team scelgono un obiettivo: aiutare i colleghi di un nuovo mercato ad adottare prima le pratiche del gruppo. Registrano il tempo di adattamento e le difficoltà.</span>
            </p>
          </li>
          <li>
            <h3>
              <span data-lang-inline="zh-CN">在实际工作中验证</span>
              <span data-lang-inline="fr">Tester sur le terrain</span>
              <span data-lang-inline="en">Test in real work</span>
              <span data-lang-inline="it">Sperimentare sul campo</span>
            </h3>
            <p>
              <span data-lang-inline="zh-CN">新市场的一支小团队试用 AI，看看它是否能帮助大家掌握这些做法。有经验的同事一起判断哪些做法适合在当地采用。</span>
              <span data-lang-inline="fr">Sur le nouveau marché, un petit groupe teste si l’IA l’aide à adopter ces pratiques. Des collègues expérimentés valident celles qui peuvent être reprises localement.</span>
              <span data-lang-inline="en">In the new market, a small team tests whether AI helps them adopt those practices. Experienced colleagues check which ones can be used locally.</span>
              <span data-lang-inline="it">Nel nuovo mercato, un piccolo team verifica se l’IA aiuta ad adottare quelle pratiche. I colleghi più esperti valutano quali si possono riprendere a livello locale.</span>
            </p>
          </li>
          <li>
            <h3>
              <span data-lang-inline="zh-CN">决定下一步投入</span>
              <span data-lang-inline="fr">Décider de la suite</span>
              <span data-lang-inline="en">Decide what comes next</span>
              <span data-lang-inline="it">Decidere come proseguire</span>
            </h3>
            <p>
              <span data-lang-inline="zh-CN">负责人根据试点结果和团队反馈，决定是继续优化、推广到其他团队，还是换一个方向。</span>
              <span data-lang-inline="fr">La direction s’appuie sur les résultats observés et les retours de l’équipe pour décider d’ajuster l’approche, de l’étendre ou de changer de priorité.</span>
              <span data-lang-inline="en">Leadership uses the observed results and team feedback to decide whether to adapt the approach, expand it, or shift priorities.</span>
              <span data-lang-inline="it">La direzione usa i risultati osservati e i riscontri del team per decidere se adattare l’approccio, estenderlo o cambiare priorità.</span>
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section pilot" id="services">
      <div class="wrap">
        <div class="section-heading">
          <h2>
            <span data-lang-inline="zh-CN">30 天 AI 转型试点</span>
            <span data-lang-inline="fr">Un pilote de transformation IA en 30 jours</span>
            <span data-lang-inline="en">A 30-day AI transformation pilot</span>
            <span data-lang-inline="it">Un pilota di trasformazione IA in 30 giorni</span>
          </h2>
          <p>
            <span data-lang-inline="zh-CN">围绕一个经营重点验证一种做法。我们会先评估可行性和风险，与你确认范围后启动试点。</span>
            <span data-lang-inline="fr">Testez une approche sur une priorité de votre entreprise. Avant de lancer le pilote, nous évaluons la faisabilité et les risques, puis validons ensemble son périmètre.</span>
            <span data-lang-inline="en">Test an approach around one business priority. Before the pilot starts, we assess feasibility and risks and agree on its scope.</span>
            <span data-lang-inline="it">Verificate un approccio su una priorità aziendale. Prima di avviare il pilota, valutiamo fattibilità e rischi, poi concordiamo il perimetro.</span>
          </p>
        </div>
        <ol class="pilot-steps" id="process">
          <li>
            <h3>
              <span data-lang-inline="zh-CN">明确起点与目标</span>
              <span data-lang-inline="fr">Établir le point de départ</span>
              <span data-lang-inline="en">Establish the starting point</span>
              <span data-lang-inline="it">Stabilire il punto di partenza</span>
            </h3>
            <p>
              <span data-lang-inline="zh-CN">与团队梳理现有做法，明确试点目标和衡量标准。</span>
              <span data-lang-inline="fr">Nous examinons les pratiques actuelles avec votre équipe et précisons l’objectif et les critères de réussite.</span>
              <span data-lang-inline="en">We review current practices with your team and confirm the goal and success criteria.</span>
              <span data-lang-inline="it">Esaminiamo le pratiche attuali con il team e precisiamo l’obiettivo e i criteri di successo.</span>
            </p>
          </li>
          <li>
            <h3>
              <span data-lang-inline="zh-CN">带团队试用</span>
              <span data-lang-inline="fr">Expérimenter avec l’équipe</span>
              <span data-lang-inline="en">Test with your team</span>
              <span data-lang-inline="it">Sperimentare con il team</span>
            </h3>
            <p>
              <span data-lang-inline="zh-CN">在约定场景中试用，帮助团队掌握做法，并记录反馈。</span>
              <span data-lang-inline="fr">Nous essayons l’approche dans le cadre convenu, accompagnons sa prise en main et recueillons les retours.</span>
              <span data-lang-inline="en">We try the approach in the agreed setting, help your team get started, and gather feedback.</span>
              <span data-lang-inline="it">Proviamo l’approccio nel contesto concordato, aiutiamo il team a usarlo e raccogliamo i riscontri.</span>
            </p>
          </li>
          <li>
            <h3>
              <span data-lang-inline="zh-CN">复盘并制定路线图</span>
              <span data-lang-inline="fr">Faire le bilan et préparer la suite</span>
              <span data-lang-inline="en">Review and plan the next steps</span>
              <span data-lang-inline="it">Valutare e pianificare i prossimi passi</span>
            </h3>
            <p>
              <span data-lang-inline="zh-CN">对照目标评估试点结果，交付复盘和下一阶段的行动路线图。</span>
              <span data-lang-inline="fr">Nous évaluons les résultats au regard de l’objectif et vous remettons un bilan et une feuille de route pour la suite.</span>
              <span data-lang-inline="en">We evaluate the results against the goal and deliver a review and a roadmap for the next stage.</span>
              <span data-lang-inline="it">Valutiamo i risultati rispetto all’obiettivo e consegniamo un bilancio e un piano per la fase successiva.</span>
            </p>
          </li>
        </ol>
        <a class="button button-primary" href="#contact">
          <span data-lang-inline="zh-CN">聊聊我的项目</span>
          <span data-lang-inline="fr">Parler de mon projet</span>
          <span data-lang-inline="en">Discuss my project</span>
          <span data-lang-inline="it">Parlare del mio progetto</span>
        </a>
      </div>
    </section>

    <section class="section about" id="about">
      <div class="wrap split">
        <h2>
          <span data-lang-inline="zh-CN">ZSJ 如何陪伴你转型</span>
          <span data-lang-inline="fr">Comment ZSJ vous accompagne</span>
          <span data-lang-inline="en">How ZSJ supports your transformation</span>
          <span data-lang-inline="it">Come ZSJ vi accompagna</span>
        </h2>
        <div class="section-copy">
          <p>
            <span data-lang-inline="zh-CN">ZSJ 服务海外华人企业与跨境团队，把企业的经营目标、团队的实际情况和 AI 的可能性放在一起考虑。</span>
            <span data-lang-inline="fr">ZSJ accompagne les entreprises de la diaspora chinoise et les équipes qui travaillent entre plusieurs marchés. Nous partons de vos objectifs et de la réalité de votre équipe pour choisir comment l’IA peut vous aider.</span>
            <span data-lang-inline="en">ZSJ works with overseas Chinese businesses and teams operating across markets. We start with your goals and how your team works to decide how AI can help.</span>
            <span data-lang-inline="it">ZSJ accompagna le imprese della diaspora cinese e i team attivi su più mercati. Partiamo dai vostri obiettivi e dal modo in cui lavora il team per capire come può aiutarvi l’IA.</span>
          </p>
          <dl class="support-options">
            <div>
              <dt>
                <span data-lang-inline="zh-CN">90 分钟转型诊断</span>
                <span data-lang-inline="fr">Diagnostic de 90 minutes</span>
                <span data-lang-inline="en">90-minute diagnostic</span>
                <span data-lang-inline="it">Diagnosi di 90 minuti</span>
              </dt>
              <dd>
                <span data-lang-inline="zh-CN">明确优先事项，整理成一页行动路线图。</span>
                <span data-lang-inline="fr">Identifier vos priorités et repartir avec une feuille de route d’une page.</span>
                <span data-lang-inline="en">Identify your priorities and leave with a one-page roadmap.</span>
                <span data-lang-inline="it">Individuare le priorità e ottenere un piano d’azione di una pagina.</span>
              </dd>
            </div>
            <div>
              <dt>
                <span data-lang-inline="zh-CN">年度转型陪跑</span>
                <span data-lang-inline="fr">Accompagnement annuel</span>
                <span data-lang-inline="en">Annual support</span>
                <span data-lang-inline="it">Accompagnamento annuale</span>
              </dt>
              <dd>
                <span data-lang-inline="zh-CN">定期复盘成果，根据业务变化调整并推进路线图。</span>
                <span data-lang-inline="fr">Faire régulièrement le point et faire évoluer la feuille de route avec votre entreprise.</span>
                <span data-lang-inline="en">Review progress regularly and adapt the roadmap as your business evolves.</span>
                <span data-lang-inline="it">Verificare regolarmente i progressi e adattare il piano all’evoluzione dell’impresa.</span>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section contact" id="contact">
      <div class="wrap contact-layout" id="chat">
        <div>
          <h2>
            <span data-lang-inline="zh-CN">聊聊我的项目</span>
            <span data-lang-inline="fr">Parler de mon projet</span>
            <span data-lang-inline="en">Discuss my project</span>
            <span data-lang-inline="it">Parlare del mio progetto</span>
          </h2>
          <p class="contact-status">{{projectIntro}}</p>
        </div>
        <form class="contact-prep" id="zsj-project-form" aria-labelledby="zsj-project-title">
          <h3 id="zsj-project-title">{{projectHeading}}</h3>
          <div class="project-fields">
            <div class="project-field">
              <label for="zsj-project-business">{{projectBusiness}}</label>
              <input id="zsj-project-business" name="business" type="text" required maxlength="200" />
            </div>
            <div class="project-field">
              <label for="zsj-project-goal">{{projectGoal}}</label>
              <input id="zsj-project-goal" name="goal" type="text" required maxlength="250" />
            </div>
            <div class="project-field">
              <label for="zsj-project-question">{{projectQuestion}}</label>
              <textarea id="zsj-project-question" name="question" rows="3" required maxlength="400"></textarea>
            </div>
          </div>
          <p class="project-privacy" id="zsj-project-privacy">{{projectPrivacy}}</p>
          <button type="submit" class="button button-primary" aria-describedby="zsj-project-privacy" disabled>{{projectSubmit}}</button>
          <p class="project-status" id="zsj-project-status" role="status"></p>
        </form>
      </div>
    </section>

    <section class="section faq" id="faq" tabindex="-1" aria-labelledby="faq-title">
      <div class="wrap split">
        <h2 id="faq-title">
          <span data-lang-inline="zh-CN">常见问题</span>
          <span data-lang-inline="fr">Questions fréquentes</span>
          <span data-lang-inline="en">Frequently asked questions</span>
          <span data-lang-inline="it">Domande frequenti</span>
        </h2>
        <div>
          <details>
            <summary>
              <span data-lang-inline="zh-CN">如果还不确定从哪里开始呢？</span>
              <span data-lang-inline="fr">Et si je ne sais pas encore par où commencer&nbsp;?</span>
              <span data-lang-inline="en">What if I don’t know where to start yet?</span>
              <span data-lang-inline="it">E se non sapessi ancora da dove iniziare?</span>
            </summary>
            <p>
              <span data-lang-inline="zh-CN">先讨论经营目标和团队现状。90 分钟转型诊断可以帮助你排出优先顺序，并整理成一页路线图。</span>
              <span data-lang-inline="fr">Commençons par vos objectifs et la façon dont travaille votre équipe. Le diagnostic de 90 minutes débouche sur une feuille de route d’une page avec vos priorités.</span>
              <span data-lang-inline="en">Start with your goals and how your team works. The 90-minute diagnostic produces a one-page roadmap with your priorities.</span>
              <span data-lang-inline="it">Iniziamo dai vostri obiettivi e dal modo in cui lavora il team. La diagnosi di 90 minuti produce un piano d’azione di una pagina con le vostre priorità.</span>
            </p>
          </details>
          <details>
            <summary>
              <span data-lang-inline="zh-CN">30 天试点结束后能拿到什么？</span>
              <span data-lang-inline="fr">Que reçoit-on à la fin du pilote&nbsp;?</span>
              <span data-lang-inline="en">What do we receive at the end of the pilot?</span>
              <span data-lang-inline="it">Cosa riceviamo al termine del pilota?</span>
            </summary>
            <p>
              <span data-lang-inline="zh-CN">你会收到试点复盘、团队使用建议和下一步路线图。具体交付内容在试点开始前共同确认。</span>
              <span data-lang-inline="fr">Vous recevez un bilan, des recommandations pour votre équipe et une feuille de route. Nous convenons des livrables précis au démarrage.</span>
              <span data-lang-inline="en">You receive a pilot review, guidance for your team, and a roadmap. We agree on the exact deliverables before the pilot begins.</span>
              <span data-lang-inline="it">Ricevete un bilancio, raccomandazioni per il team e un piano d’azione. Concordiamo i risultati da consegnare prima dell’avvio.</span>
            </p>
          </details>
          <details>
            <summary>
              <span data-lang-inline="zh-CN">如何考虑数据和运营风险？</span>
              <span data-lang-inline="fr">Comment évaluez-vous les risques liés au projet&nbsp;?</span>
              <span data-lang-inline="en">How do you assess project risks?</span>
              <span data-lang-inline="it">Come valutate i rischi del progetto?</span>
            </summary>
            <p>
              <span data-lang-inline="zh-CN">试点前会评估需要用到的数据、团队参与方式和潜在风险，并约定哪些环节需要人工复核。</span>
              <span data-lang-inline="fr">Avant le pilote, nous examinons les données nécessaires, le rôle de l’équipe et les risques. Nous précisons les étapes qui demandent une validation humaine.</span>
              <span data-lang-inline="en">Before the pilot, we review the data needed, the team’s role, and potential risks. We agree on the steps that need human review.</span>
              <span data-lang-inline="it">Prima del pilota valutiamo i dati necessari, il ruolo del team e i rischi. Definiamo i passaggi che richiedono una verifica umana.</span>
            </p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="wechat">
    <div class="wrap">
      <span class="zsj-wechat-contact">
        <a class="zsj-wechat-image" href="{{assetPrefix}}assets/wechat-qr.png" target="_blank" rel="noopener">
          <img src="{{assetPrefix}}assets/wechat-qr.png" width="740" height="740" loading="lazy" decoding="async" alt="{{wechatEnlarge}}" />
        </a>
        <span class="zsj-wechat-copy">
          <strong>{{wechatLabel}}</strong>
          <span>{{wechatHelp}}</span>
        </span>
      </span>
{{analyticsPrivacy}}
      <div class="footer-inner">
        <span>© <span id="y"></span> ZSJ</span>
        <span>
          <span data-lang-inline="zh-CN">聊天消息由 OpenAI 处理以生成回复。</span>
          <span data-lang-inline="fr">OpenAI traite les messages du chat pour générer les réponses.</span>
          <span data-lang-inline="en">OpenAI processes chat messages to generate replies.</span>
          <span data-lang-inline="it">OpenAI elabora i messaggi della chat per generare le risposte.</span>
        </span>
      </div>
    </div>
  </footer>

  <aside id="analytics-consent" hidden tabindex="-1" aria-labelledby="analytics-heading"
   >
    <h2 id="analytics-heading">{{analyticsHeading}}</h2>
    <p>{{analyticsNotice}}
      <a href="https://policies.google.com/technologies/partner-sites">{{analyticsPolicy}}</a>
    </p>
    <div class="analytics-actions">
      <button id="analytics-accept" type="button">{{analyticsAccept}}</button>
      <button id="analytics-refuse" type="button">{{analyticsRefuse}}</button>
    </div>
  </aside>

  <div class="zsj-chat" hidden>
    <button type="button" class="zsj-chat-launcher" id="zsj-chat-launcher" data-zsj-chat-open
      aria-controls="zsj-chat-panel" aria-expanded="false" aria-haspopup="dialog">
      <span class="zsj-chat-icon" aria-hidden="true"></span>
      <span data-chat-label="launcher"></span>
    </button>
    <section class="zsj-chat-panel" id="zsj-chat-panel" role="dialog" aria-labelledby="zsj-chat-title" hidden>
      <header class="zsj-chat-header">
        <span class="zsj-chat-mark" aria-hidden="true">ZSJ</span>
        <h2 id="zsj-chat-title" data-chat-label="title" tabindex="-1"></h2>
        <button type="button" id="zsj-chat-close" class="zsj-chat-close">
          <span aria-hidden="true">×</span>
        </button>
      </header>
      <div class="zsj-chat-log" id="zsj-chat-log" role="log" tabindex="0" aria-labelledby="zsj-chat-title">
        <p class="zsj-chat-message zsj-chat-message-assistant" data-chat-label="welcome" id="zsj-chat-welcome"></p>
      </div>
      <form class="zsj-chat-form" id="zsj-chat-form">
        <p class="zsj-chat-status" id="zsj-chat-status" role="status"></p>
        <a class="zsj-chat-faq" id="zsj-chat-faq" href="#faq" data-chat-label="faq" hidden></a>
        <label for="zsj-chat-message" class="zsj-chat-sr-only" data-chat-label="message"></label>
        <div class="zsj-chat-controls">
          <textarea id="zsj-chat-message" name="message" rows="2" maxlength="1000"
            aria-describedby="zsj-chat-notice"></textarea>
          <button type="submit" class="zsj-chat-send" id="zsj-chat-send" disabled></button>
        </div>
        <p class="zsj-chat-notice" id="zsj-chat-notice" data-chat-label="notice"></p>
      </form>
    </section>
  </div>

  <script>
    document.getElementById('y').textContent = new Date().getFullYear();
    if (location.protocol === 'file:') {
      for (const link of document.querySelectorAll('.locale-switch a')) {
        link.setAttribute('href', link.getAttribute('href') + 'index.html');
      }
    }
  </script>
</body>
</html>
